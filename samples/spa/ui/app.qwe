// The App component owns the page: the tab bar, the theme switch and the tab
// the address names. It runs in the browser once the page has loaded, so moving
// between tabs changes only the tab, and what App holds stays.

use lib/note.qwe
use lib/tasks.qwe
use ui/theme_switch.qwe

// The tab for a path, as the server's routes would match it.
fn tab_of(path: str) -> str = match split(path, "/") | filter((s) => s != "") {
    [] => "home"
    ["tasks"] => "tasks"
    ["notes"] => "notes"
    ["settings"] => "settings"
    _ => "missing"
}

view Tab(href: str, here: bool, children) =
    <a {href} aria-current={here ? "page" : null}>{children}</a>

view Home() =
    <section>
        <h2>Home</h2>
        <p>A single-page app in Quillo. Each tab above is a link: the address changes and
        the page does not reload, so what the app holds stays. Back and Forward work, and a
        reload opens the same tab, made on the server.</p>
        <p class="muted">Try <a href="/tasks">Tasks</a>, then <a href="/notes">Notes</a>.</p>
    </section>

component TasksTab() {
    state items = list_tasks()
    state draft = ""
    state problem = null
    <section>
        <h2>Tasks</h2>
        <form.add @submit={() => {
            let r = add_task(draft)
            if is_err(r) {
                problem = r.error
            } else {
                items = r
                draft = ""
                problem = null
            }
        }}>
            <input bind:value={draft} placeholder="Something to do" aria-label="New task"/>
            <button>Add</button>
        </form>
        {problem && <p.problem>{problem}</p>}
        {items == null
            ? <p.muted>Loading…</p>
            : <ul.list.card>{for t in items =>
                <li key={t.id}>
                    <label class={t.done == 1 && "done"}>
                        <input type="checkbox" checked={t.done == 1} @change={() => {
                            let r = toggle_task(t.id)
                            if !is_err(r) { items = r }
                        }}/>
                        {t.text}
                    </label>
                </li>}</ul>}
    </section>
}

view Settings() =
    <section>
        <h2>Settings</h2>
        <p>The theme is Quillo UI's. The switch in the bar changes it at once, without
        reloading the page, and keeps it in a cookie, so the server renders the next page
        in it too. System follows the light or dark setting of your computer.</p>
    </section>

view Missing(path: str) =
    <section>
        <h2>Not found</h2>
        <p>No tab is at <code>{path}</code>. <a href="/">Go home</a>.</p>
    </section>

// saved_note: the note as the database has it when the page is made.
component App(theme: str, saved_note: str) {
    state note = saved_note
    state saved = saved_note        // what the database has
    state saving = false            // a save is on its way
    state failed = null             // the text the last save could not keep
    state note_problem = null       // and why
    let path = url().path
    let tab = tab_of(path)
    // Half a second after the typing stops, the note goes to the database. This
    // statement reads `note`, so each key starts the wait again; it is App's, so
    // moving to another tab meanwhile does not stop it. One save at a time, each
    // with the newest text, so a slow answer cannot put an older text back. A
    // save that fails is not tried again until the note changes.
    if note != saved && note != failed && !saving {
        every(500, () => {
            let text = note
            saving = true
            let r = save_note(text)
            if is_err(r) {
                failed = text
                note_problem = r.error
            } else {
                saved = text
                failed = null
                note_problem = null
            }
            saving = false
        })
    }
    <div.app>
        <header.bar>
            <b>spa</b>
            <ThemeSwitch start={theme}/>
        </header>
        <nav.tabs aria-label="Tabs">
            <Tab href="/" here={tab == "home"}>Home</Tab>
            <Tab href="/tasks" here={tab == "tasks"}>Tasks</Tab>
            <Tab href="/notes" here={tab == "notes"}>Notes</Tab>
            <Tab href="/settings" here={tab == "settings"}>Settings</Tab>
        </nav>
        <main>
            {match tab {
                "home" => <Home/>
                "tasks" => <TasksTab/>
                "notes" =>
                    <section>
                        <h2>Notes</h2>
                        <textarea.note bind:value={note} maxlength="20000" placeholder="Write here, reload, come back tomorrow" aria-label="Note"></textarea>
                        <p class="muted">{len(note)} characters · {note_problem != null ? `Not saved: ${note_problem}` : note == saved ? "Saved" : "Saving…"}. Kept in
                        the app's database (SQLite) half a second after you stop typing, so a reload or
                        a restart keeps it; every visitor sees the same note, as with the tasks.</p>
                    </section>
                "settings" => <Settings/>
                _ => <Missing {path}/>
            }}
        </main>
    </div>
}
