// The document around the app, in Quillo UI's theme.

use ui/theme.qwe
use ui/theme_switch.qwe

let page_css = css`
.app { max-width: 46rem; margin: 0 auto; padding: 0 1.25rem 3rem; }
.bar { display: flex; align-items: center; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid var(--ui-border); }
.bar b { font-size: 1.05rem; margin-right: auto; }
.tabs { display: flex; gap: .25rem; margin: 1rem 0 1.5rem; border-bottom: 1px solid var(--ui-border); }
.tabs a { padding: .55rem .9rem; border-bottom: 2px solid transparent; margin-bottom: -1px; color: var(--ui-muted); font-weight: 500; text-decoration: none; }
.tabs a:hover { color: var(--ui-fg); }
.tabs a[aria-current="page"] { color: var(--ui-accent); border-bottom-color: var(--ui-accent); }
.tabs a:focus-visible { outline: none; box-shadow: var(--ui-focus); border-radius: var(--ui-radius-sm); }
h2 { margin: 0 0 .75rem; font-size: 1.4rem; letter-spacing: -.01em; }
.muted { color: var(--ui-muted); }
.problem { color: var(--ui-danger); }
.card { padding: 1rem 1.25rem; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface); box-shadow: var(--ui-shadow); }
.add { display: flex; gap: .5rem; margin-bottom: 1rem; }
.add input, .note { flex: 1; padding: .55rem .75rem; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-bg); color: var(--ui-fg); font: inherit; }
.note { display: block; width: 100%; min-height: 9rem; resize: vertical; }
.add input:focus-visible, .note:focus-visible { outline: none; border-color: var(--ui-accent); box-shadow: var(--ui-focus); }
.add button { padding: 0 1.1rem; border: 0; border-radius: var(--ui-radius-sm); background: var(--ui-accent); color: var(--ui-accent-fg); font: 600 14px/1 var(--ui-font); cursor: pointer; }
.list { margin: 0; padding: .25rem 1.25rem; list-style: none; }
.list li { padding: .5rem 0; border-top: 1px solid var(--ui-border); }
.list li:first-child { border-top: 0; }
.list label { display: flex; align-items: center; gap: .6rem; cursor: pointer; }
.list input { width: 1rem; height: 1rem; margin: 0; accent-color: var(--ui-accent); }
.list .done { color: var(--ui-muted); text-decoration: line-through; }
.theme-switch { display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--ui-border); border-radius: 999px; background: var(--ui-subtle); }
.theme-switch button { height: 28px; padding: 0 12px; border: 0; border-radius: 999px; background: transparent; color: var(--ui-muted); font: 500 13px/1 var(--ui-font); cursor: pointer; }
.theme-switch button[aria-pressed="true"] { background: var(--ui-surface); color: var(--ui-fg); box-shadow: var(--ui-shadow); }
.theme-switch button:focus-visible { outline: none; box-shadow: var(--ui-focus); }
`

view Page(title: str, children) =
    <html lang="en" class={theme_class(theme_now())}>
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>{title}</title>
            <style>{theme_css + page_css}</style>
        </head>
        <body.ui-root>{children}</body>
    </html>
